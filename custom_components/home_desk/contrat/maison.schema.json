{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "La sous-entree maison : sources media et appareils",
  "description": "Ce que TOUTES les tablettes partagent, declare une seule fois au niveau de la maison. `sources` : des sources d'ecran ($defs/source de ecran.schema.json) dont la piece est OBLIGATOIRE : une source de la maison sans piece ne dirait pas a la tablette ou elle joue. `appareils` (version 2) : les appareils derriere les cartes de la pile. Le nom de la piece vient de la configuration, jamais du code.",
  "type": "object",
  "required": ["version", "sources", "appareils"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 2},
    "sources": {
      "type": "array",
      "items": {"allOf": [{"$ref": "ecran.schema.json#/$defs/source"}, {"required": ["piece"]}]}
    },
    "appareils": {"type": "array", "items": {"$ref": "#/$defs/appareil"}}
  },
  "$defs": {
    "listeEntites": {"type": "array", "items": {"$ref": "ecran.schema.json#/$defs/entite"}},
    "entiteBouton": {
      "type": "string",
      "pattern": "^button\\.[a-z0-9_]+$",
      "description": "Un entity_id du domaine button : la carte le presse par button.press, et l'integration qui le fournit (ha-bambulab pour l'imprimante) n'expose ces actions qu'en boutons. Un script ou un interrupteur serait un bouton mort."
    },
    "entiteProbleme": {
      "type": "string",
      "pattern": "^binary_sensor\\.[a-z0-9_]+$",
      "description": "Un entity_id du domaine binary_sensor : un probleme (fontaine vide, filtre a changer, panne) est un etat `on`, et un capteur d'un autre domaine ne le dit jamais."
    },
    "entiteCapteur": {
      "type": "string",
      "pattern": "^sensor\\.[a-z0-9_]+$",
      "description": "Un entity_id du domaine sensor : une mesure (les jours de filtre restants)."
    },
    "entiteReglage": {
      "type": "string",
      "pattern": "^(number|input_number)\\.[a-z0-9_]+$",
      "description": "Un entity_id du domaine number ou input_number : la carte l'ecrit par `<domaine>.set_value`, avec l'attribut `min` de l'entite pour valeur."
    },
    "entiteVentilateur": {
      "type": "string",
      "pattern": "^fan\\.[a-z0-9_]+$",
      "description": "Un entity_id du domaine fan : la carte l'allume et l'eteint par `fan.toggle` et lit ses `preset_modes`, ce qu'aucun autre domaine ne publie."
    },
    "listeCapteurs": {
      "type": "array",
      "items": {"$ref": "#/$defs/entiteCapteur"},
      "description": "Une liste d'entity_id du domaine sensor (les niveaux de cartouche)."
    },
    "appareil": {
      "type": "object",
      "description": "Un appareil de la maison. `piece` : le nom d'une piece, ou \"maison\" pour un appareil montre partout ; toute chaine non vide, comme la `piece` d'une source (aucune liste de pieces ne vit dans le contrat). `entites` : des roles vers des entity_id ; les roles requis et facultatifs dependent de `type`, une branche `if/then` par type ci-dessous, et un role inconnu de son type est refuse. Les roles listes (`ams`, `sondes`, `zones`, `niveaux`) sont des tableaux d'entity_id, tous les autres un seul entity_id. `seuil` est REQUIS pour `air` et `encre`, FACULTATIF pour `plantes` (l'humidite sous laquelle une sonde sans `soil_warning` appelle un arrosage) et INTERDIT ailleurs : un seuil ignore serait une valeur saisie pour rien.",
      "required": ["type", "piece", "entites"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "imprimante",
            "aspirateur",
            "voiture",
            "animaux",
            "plantes",
            "tapis",
            "air",
            "alarme",
            "encre"
          ]
        },
        "piece": {"type": "string", "minLength": 1},
        "entites": {"type": "object"},
        "seuil": {"type": "number", "minimum": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "imprimante"}}, "required": ["type"]},
          "then": {
            "properties": {
              "entites": {
                "required": ["etat", "progression"],
                "additionalProperties": false,
                "properties": {
                  "etat": {"$ref": "ecran.schema.json#/$defs/entite"},
                  "progression": {"$ref": "ecran.schema.json#/$defs/entite"},
                  "finTache": {"$ref": "ecran.schema.json#/$defs/entite"},
                  "couche": {"$ref": "ecran.schema.json#/$defs/entite"},
                  "couchesTotal": {"$ref": "ecran.schema.json#/$defs/entite"},
                  "tache": {"$ref": "ecran.schema.json#/$defs/entite"},
                  "couverture": {"$ref": "ecran.schema.json#/$defs/entite"},
                  "camera": {"$ref": "ecran.schema.json#/$defs/entite"},
                  "pause": {"$ref": "#/$defs/entiteBouton"},
                  "reprise": {"$ref": "#/$defs/entiteBouton"},
                  "arret": {"$ref": "#/$defs/entiteBouton"},
                  "erreur": {"$ref": "ecran.schema.json#/$defs/entite"},
                  "ams": {"$ref": "#/$defs/listeEntites", "maxItems": 4}
                }
              }
            },
            "not": {"required": ["seuil"]}
          }
        },
        {
          "if": {"properties": {"type": {"const": "aspirateur"}}, "required": ["type"]},
          "then": {
            "properties": {
              "entites": {
                "required": ["aspirateur"],
                "additionalProperties": false,
                "properties": {
                  "aspirateur": {"$ref": "ecran.schema.json#/$defs/entite"},
                  "plan": {"$ref": "ecran.schema.json#/$defs/entite"},
                  "erreur": {"$ref": "ecran.schema.json#/$defs/entite"}
                }
              }
            },
            "not": {"required": ["seuil"]}
          }
        },
        {
          "if": {"properties": {"type": {"const": "voiture"}}, "required": ["type"]},
          "then": {
            "properties": {
              "entites": {
                "required": ["batterie", "branchee"],
                "additionalProperties": false,
                "properties": {
                  "batterie": {"$ref": "ecran.schema.json#/$defs/entite"},
                  "branchee": {"$ref": "ecran.schema.json#/$defs/entite"},
                  "enCharge": {"$ref": "ecran.schema.json#/$defs/entite"},
                  "autonomie": {"$ref": "ecran.schema.json#/$defs/entite"},
                  "limite": {"$ref": "ecran.schema.json#/$defs/entite"},
                  "finCharge": {"$ref": "ecran.schema.json#/$defs/entite"},
                  "demarrerCharge": {"$ref": "ecran.schema.json#/$defs/entite"},
                  "arreterCharge": {"$ref": "ecran.schema.json#/$defs/entite"}
                }
              }
            },
            "not": {"required": ["seuil"]}
          }
        },
        {
          "if": {"properties": {"type": {"const": "animaux"}}, "required": ["type"]},
          "then": {
            "properties": {
              "entites": {
                "anyOf": [
                  {"required": ["fontaineVide"]},
                  {"required": ["filtre"]},
                  {"required": ["panneFontaine"]},
                  {"required": ["panneDistributeur"]}
                ],
                "additionalProperties": false,
                "properties": {
                  "fontaineVide": {"$ref": "#/$defs/entiteProbleme"},
                  "filtre": {"$ref": "#/$defs/entiteProbleme"},
                  "panneFontaine": {"$ref": "#/$defs/entiteProbleme"},
                  "panneDistributeur": {"$ref": "#/$defs/entiteProbleme"},
                  "joursFiltre": {"$ref": "#/$defs/entiteCapteur"},
                  "nourrir": {"$ref": "#/$defs/entiteReglage"}
                }
              }
            },
            "not": {"required": ["seuil"]}
          }
        },
        {
          "if": {"properties": {"type": {"const": "plantes"}}, "required": ["type"]},
          "then": {
            "properties": {
              "entites": {
                "required": ["sondes"],
                "additionalProperties": false,
                "properties": {
                  "sondes": {"$ref": "#/$defs/listeEntites", "minItems": 1},
                  "habitude": {"$ref": "ecran.schema.json#/$defs/entite"}
                }
              },
              "seuil": true
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "tapis"}}, "required": ["type"]},
          "then": {
            "properties": {
              "entites": {
                "required": ["vitesse"],
                "additionalProperties": false,
                "properties": {
                  "vitesse": {"$ref": "#/$defs/entiteCapteur"},
                  "pas": {"$ref": "#/$defs/entiteCapteur"},
                  "distance": {"$ref": "#/$defs/entiteCapteur"},
                  "reglageVitesse": {"$ref": "#/$defs/entiteReglage"},
                  "arret": {"$ref": "#/$defs/entiteBouton"}
                }
              }
            },
            "not": {"required": ["seuil"]}
          }
        },
        {
          "if": {"properties": {"type": {"const": "air"}}, "required": ["type"]},
          "then": {
            "properties": {
              "entites": {
                "required": ["pm25", "purificateur"],
                "additionalProperties": false,
                "properties": {
                  "pm25": {"$ref": "#/$defs/entiteCapteur"},
                  "purificateur": {"$ref": "#/$defs/entiteVentilateur"}
                }
              }
            },
            "required": ["seuil"]
          }
        },
        {
          "if": {"properties": {"type": {"const": "alarme"}}, "required": ["type"]},
          "then": {
            "properties": {
              "entites": {
                "required": ["zones"],
                "additionalProperties": false,
                "properties": {"zones": {"$ref": "#/$defs/listeEntites", "minItems": 1}}
              }
            },
            "not": {"required": ["seuil"]}
          }
        },
        {
          "if": {"properties": {"type": {"const": "encre"}}, "required": ["type"]},
          "then": {
            "properties": {
              "entites": {
                "required": ["niveaux"],
                "additionalProperties": false,
                "properties": {"niveaux": {"$ref": "#/$defs/listeCapteurs", "minItems": 1}}
              }
            },
            "required": ["seuil"]
          }
        }
      ]
    }
  }
}
